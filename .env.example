# Sao chép thành .env rồi chỉnh. Mặc định chạy offline (mock LLM + hashing embedding) để dev/test.

# Nếu đặt, các endpoint quản trị (nạp tài liệu, sinh câu hỏi, đánh giá) cần header X-Admin-Key
ADMIN_API_KEY=

DATABASE_URL=sqlite:///./data/app.db
VECTOR_STORE_PATH=./data/vectors

# --- LLM ---
# mock | gemini | openai_compat   (openai_compat = Groq, Ollama, OpenRouter, vLLM...)
LLM_PROVIDER=mock
# Ví dụ Gemini:
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
# Ví dụ Groq:
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=
#LLM_API_KEY=
# Ví dụ Ollama:
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=qwen2.5:7b

# --- Embedding ---
# hashing (offline, chỉ để dev/test) | sentence_transformers (khuyên dùng khi chạy thật)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-m3

# --- Chunking ---
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=100

# --- Sinh câu hỏi ---
VALIDATE_QUESTIONS=true
DEDUP_THRESHOLD=0.92
RETRIEVAL_TOP_K=2
GENERATE_ON_DEMAND=true
