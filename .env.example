# Sao chép thành .env rồi chỉnh. Tên biến = tên trường trong app/config.py (không phân biệt hoa thường).
# LƯU Ý: mặc định TRONG MÃ (app/config.py) là offline (mock LLM + hashing embedding), nhưng file mẫu này đặt sẵn
# LLM_PROVIDER=gemini. Muốn chạy offline ngay: đổi thành LLM_PROVIDER=mock (khi đó bỏ qua LLM_MODEL, LLM_API_KEY).

# Nếu đặt, các endpoint quản trị (nạp tài liệu, sinh câu hỏi, đánh giá) cần header X-Admin-Key
# Để trống = không bảo vệ (chỉ nên dùng khi chạy máy cá nhân). Đặt giá trị thì cần nhập đúng khoá ở trang Quản trị.
ADMIN_API_KEY=

# Nơi lưu dữ liệu. Có thể đổi sang PostgreSQL bằng URL SQLAlchemy khác (cần cài thêm driver).
DATABASE_URL=sqlite:///./data/app.db
# Thư mục lưu vector (file numpy). Đổi embedding model thì xoá thư mục này và nạp lại tài liệu.
VECTOR_STORE_PATH=./data/vectors

# --- LLM ---
# Bắt buộc theo nhà cung cấp: gemini cần LLM_MODEL + LLM_API_KEY; openai_compat cần LLM_BASE_URL + LLM_MODEL
# (LLM_API_KEY để trống với Ollama); mock không cần gì.
# mock | gemini | openai_compat   (openai_compat = Groq, Ollama, OpenRouter, vLLM...)
LLM_PROVIDER=gemini
# Ví dụ Gemini:
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
# Ví dụ Groq:
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=openai/gpt-oss-120b
#LLM_API_KEY=
# Ví dụ Ollama:
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=qwen2.5:7b

# --- Embedding ---
# hashing (offline, chỉ để dev/test) | sentence_transformers (khuyên dùng khi chạy thật)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-m3

# --- Chunking ---
# Độ dài tối đa của một đoạn (ký tự) và phần chồng lấn giữa hai đoạn kề nhau. Đoạn quá ngắn bị gộp (chunk_min_chars trong config.py).
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=100

# --- Sinh câu hỏi ---
# true = thêm 1 lượt gọi LLM cho MỖI câu hỏi (chất lượng cao hơn, nhưng gấp ~3 lần số lượt gọi). Gói miễn phí hay bị 429: cân nhắc false.
VALIDATE_QUESTIONS=true
# Giãn cách tối thiểu giữa hai lần gọi LLM (giây). Gemini free ~10 lần/phút -> 6.
LLM_MIN_INTERVAL_S=0
# Ngưỡng cosine để coi hai câu hỏi là trùng (0..1, càng thấp càng loại nhiều).
DEDUP_THRESHOLD=0.92
# Số đoạn lân cận lấy làm ngữ cảnh khi sinh câu mức "vận dụng".
RETRIEVAL_TOP_K=2
# true = người học hết câu trong ngân hàng thì sinh thêm ngay (có thể chờ vài giây); false = chỉ dùng câu đã sinh sẵn bằng scripts.generate.
GENERATE_ON_DEMAND=true
